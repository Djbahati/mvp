# ==============================
# EMAIL / SMTP
# ==============================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

# ==============================
# GOOGLE GEMINI AI
# ==============================
GEMINI_API_KEY=your_gemini_api_key

# ==============================
# GOOGLE OAUTH LOGIN
# ==============================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==============================
# JWT AUTHENTICATION
# ==============================
JWT_SECRET=generate_a_long_random_secret_here
JWT_REFRESH_SECRET=generate_another_long_random_secret_here

# ==============================
# LNBITS / LIGHTNING
# ==============================
LNBITS_URL=https://your-lnbits-domain.com
LNBITS_ADMIN_KEY=your_lnbits_admin_key
LNBITS_INVOICE_KEY=your_lnbits_invoice_key

# ==============================
# OPENNODE
# ==============================
OPENNODE_API_KEY=your_opennode_api_key

# ==============================
# SMS
# ==============================
SMS_API_KEY=your_sms_provider_api_key
SMS_PROVIDER=your_sms_provider

# ==============================
# SPARK
# ==============================
SPARK_WEBHOOK_SECRET=your_spark_webhook_secret

